# Copy this file to .env and fill in your CognoDB Cloud instance details.
# Get these from https://console.cognodb.com after creating a free (c0) instance.
# The password is shown exactly once at creation time — save it immediately.

COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your-generated-password>

# Optional: port for the Express API
PORT=4000

# Optional: allowed origin for CORS (your deployed frontend URL)
CLIENT_ORIGIN=http://localhost:5173
